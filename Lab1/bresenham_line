import glfw
from OpenGL.GL import *

# Plot a point
def plot(x, y):
    glVertex2i(x, y)

# Bresenham Line Algorithm
def bresenham_line(x1, y1, x2, y2):
    dx = abs(x2 - x1)
    dy = abs(y2 - y1)

    sx = 1 if x2 > x1 else -1
    sy = 1 if y2 > y1 else -1

    err = dx - dy

    glBegin(GL_POINTS)

    while True:
        plot(x1, y1)

        if x1 == x2 and y1 == y2:
            break

        e2 = 2 * err

        if e2 > -dy:
            err -= dy
            x1 += sx

        if e2 < dx:
            err += dx
            y1 += sy

    glEnd()


def display():
    glClear(GL_COLOR_BUFFER_BIT)

    glColor3f(1, 1, 1)

    bresenham_line(100, 100, 500, 350)

    glFlush()


def main():
    if not glfw.init():
        return

    window = glfw.create_window(600, 600, "Bresenham Line", None, None)

    glfw.make_context_current(window)

    glClearColor(0, 0, 0, 1)

    glMatrixMode(GL_PROJECTION)
    glLoadIdentity()
    glOrtho(0, 600, 0, 600, -1, 1)

    while not glfw.window_should_close(window):
        display()
        glfw.swap_buffers(window)
        glfw.poll_events()

    glfw.terminate()


if __name__ == "__main__":
    main()